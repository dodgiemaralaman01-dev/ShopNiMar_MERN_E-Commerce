# Copy this file to .env. Keep .env private and out of version control.
# Generate a password hash with: npm run hash:admin-password
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=run-npm-run-hash-admin-password
ADMIN_JWT_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
ADMIN_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
